# ============================================================
# FuturesMind — Commodity Futures Multi-Agent Research System
# ============================================================
# Copy this file to .env and fill in your API keys.
# .env is git-ignored and will NOT be committed.

# ---------- Recommended: DeepSeek ----------
# Dual-model strategy: Flash (fast/cheap, strong Agent) for analysts+debate,
# Pro (flagship) for Synthesis+Scenario deep reasoning.
# Flash: 130B active params, 1元/百万tokens input (vs Pro ~20元)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash

# ---------- Output Language ----------
# Chinese (默认) or English
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese

# ---------- Agent Iterations ----------
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# ============================================================
# Alternative Providers (uncomment one section)
# ============================================================

# --- OpenAI ---
# TRADINGAGENTS_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-5
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-5-mini

# --- Anthropic ---
# TRADINGAGENTS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key
# TRADINGAGENTS_DEEP_THINK_LLM=claude-sonnet-5
# TRADINGAGENTS_QUICK_THINK_LLM=claude-haiku-4-5

# --- Google ---
# TRADINGAGENTS_LLM_PROVIDER=google
# GOOGLE_API_KEY=your_google_key

# --- Other providers supported ---
# DeepSeek | OpenAI | Anthropic | Google | Groq | Mistral | Bedrock
# Qwen(通义千问) | GLM(智谱) | MiniMax | Moonshot | OpenAI-compatible
# See pyproject.toml for full dependency list

# ============================================================
# Research collection (研报采集)
# ============================================================
# 【本地导入并行度】📁 本地导入 / source="local" / ingest_local_pdfs.py 的线程数。
# 缺省 4,内部自动钳制到 [1, 5]。单篇研报同一时刻只挂 1 个 LLM 调用,故 N 个 worker
# ≈ N 路并发 LLM 调用;上限 5 是因为 LLM 账户并发上限为 5,再高只会触发 429。
# 留 1 路余量给其他链路(定时采集 / 网页上传),因此缺省取 4 而非 5。
# 不设或留空 = 用缺省 4(改这里不影响华泰/国君/东证三条 API 采集链路)。
# 登记阶段(抽正文/幂等/复制)与处理阶段同宽,故这个值同时决定两阶段的并发。
# LOCAL_IMPORT_WORKERS=4
#
# 【本地导入审计日志路径】导入全程(逐篇 QUEUE/SKIP/ERROR + id + took= + 批次汇总)
# 追加写到该文件。缺省 = 项目根 ./local_import.log。
# 为什么需要:web_app 从不调 logging.basicConfig,根 logger 缺省 WARNING,模块内
# logger.info 会被静默丢弃;而 stdout 又会被守护脚本重定向、每次重启 truncate ——
# 没有这份日志时,事后只能翻数据库倒推"那次导入到底登记了哪几篇、哪些被幂等跳过"。
# 一般不用设;测试/多实例场景把它指到独立路径即可。
# LOCAL_IMPORT_LOG=./local_import.log

# ============================================================
# WeChat QA Bot (wechat_bot.py, port 5001, 公众号测试号通道)
# ============================================================
# WECHAT_TOKEN: 自定义 3-32 位字母数字,须与测试号面板「接口配置信息」中的 Token 一致
WECHAT_TOKEN=your_wechat_callback_token_here
# 测试号页面的 appID / appsecret(留空 = 被动回复可用,但客服消息推送禁用)
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_BOT_PORT=5001
# 本机 web_app(QA API)地址
WECHAT_QA_BASE_URL=http://127.0.0.1:5000
# 逗号分隔 openid 白名单;留空 = 允许所有关注者
WECHAT_ALLOWED_OPENIDS=
