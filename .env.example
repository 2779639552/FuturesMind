# ============================================================
# AgentSense — Commodity Futures Multi-Agent Research System
# ============================================================
# Copy this file to .env and fill in your API keys.
# .env is git-ignored and will NOT be committed.

# ---------- Recommended: DeepSeek ----------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-pro

# ---------- Output Language ----------
# Chinese (默认) or English
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese

# ---------- Agent Iterations ----------
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# ============================================================
# Alternative Providers (uncomment one section)
# ============================================================

# --- OpenAI ---
# TRADINGAGENTS_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-5
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-5-mini

# --- Anthropic ---
# TRADINGAGENTS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key
# TRADINGAGENTS_DEEP_THINK_LLM=claude-sonnet-5
# TRADINGAGENTS_QUICK_THINK_LLM=claude-haiku-4-5

# --- Google ---
# TRADINGAGENTS_LLM_PROVIDER=google
# GOOGLE_API_KEY=your_google_key

# --- Other providers supported ---
# DeepSeek | OpenAI | Anthropic | Google | Groq | Mistral | Bedrock
# Qwen(通义千问) | GLM(智谱) | MiniMax | Moonshot | OpenAI-compatible
# See pyproject.toml for full dependency list
