# ============================================================
# data_collection (FuturesSentiment) — 密钥配置模板
# ============================================================
# 复制为 .env 并填写。完整说明见 CONFIG_GUIDE.md
# 注意：.env 已被 .gitignore 排除，不会提交到仓库。

# ---------- 小红书 Cookie（采集小红书数据必须，存到 Spider_XHS/.env） ----------
# 获取方式：cd Spider_XHS && python get_cookie.py （扫码自动写入）
COOKIES=

# ---------- 微博 Cookie（可选，提升微博采集稳定性） ----------
WEIBO_COOKIE=

# ---------- 情感分析 LLM 密钥（二选一或都填；都不填则降级规则引擎） ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- HuggingFace Token（可选，VLM 图片深度分析 --mode deep） ----------
HF_TOKEN=

# ---------- 主系统 LLM（FuturesMind 分析/辩论必需） ----------
# 完整模板见根目录 .env.example
DEEPSEEK_API_KEY=
